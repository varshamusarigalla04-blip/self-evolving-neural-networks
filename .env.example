# ===================================================================
# Self-Evolving Neural Networks - Environment Configuration Template
# ===================================================================

# BACKEND SERVERLESS ENVIRONMENT VARIABLE (Vercel):
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables.
# IMPORTANT: Never prefix with VITE_ to keep it private on the backend server!
EVOLVE_API_KEY=your_private_api_key_here

# OPTIONAL LOCAL CLIENT DEVELOPMENT:
# Only for local client development fallback (never put real production secrets here):
VITE_API_KEY=
